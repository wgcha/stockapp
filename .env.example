# Copy to .env and fill locally. Never commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_CHAT_ID=

TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
TOSSINVEST_ACCOUNT_SEQ=

# This program provides investment guides only. Live trading is not supported.
# mock is reserved for internal strategy research and paper evaluation.
AGENT_EXECUTION_ENV=mock
# Legacy safeguards for removed live-order support; keep both false.
AGENT_LIVE_TRADING_ENABLED=false
TOSSINVEST_LIVE_ORDERS=false
AGENT_MAX_ORDER_NOTIONAL=1000000
AGENT_MAX_ORDERS_PER_DAY=5
# Optional reference equity for risk-budget calculations in guides.
AGENT_ACCOUNT_EQUITY_KRW=
DAILY_GUIDE_HOUR_KST=9
DAILY_GUIDE_MINUTE_KST=10
# Optional local JSON with verified KRX notices; loaded on startup.
KRX_CALENDAR_OVERRIDES=
AGENT_MAX_DAILY_LOSS_PCT=1.5
AGENT_DATA_DIR=/data

PAPER_INITIAL_CAPITAL_KRW=10000000
PAPER_EVALUATION_MAX_SYMBOLS=20
INTRADAY_MINIMUM_BARS=300
INTRADAY_ARCHIVE_MAX_SYMBOLS=5
# Decimal rate, e.g. 0.00015 means 0.015%. Leave blank if unknown.
MIRAE_PAPER_COMMISSION_RATE=

# Optional official data providers.
OPENDART_API_KEY=
ECOS_API_KEY=
ECOS_QUERIES=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
OVERSEAS_BENCHMARK_SYMBOLS=SPY,QQQ
NEWS_MAX_SYMBOLS=20

# Low-cost monthly academic metadata discovery. No paper body is downloaded.
CROSSREF_DISCOVERY_ENABLED=true
CROSSREF_DISCOVERY_ROWS=20
# Optional but recommended by Crossref for its polite pool.
CROSSREF_MAILTO=
