# Private mobile API settings. Copy to a local .env.mobile and fill secrets there.
# Generate a random key with at least 32 characters. Never commit the real key.
MOBILE_API_TOKEN=
MOBILE_OWNER_USER_ID=1

# Optional read-only market data. Keep these keys on the Python host, never in the APK.
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
TOSSINVEST_ACCOUNT_SEQ=
