# PC trial configuration for the current Telegram-based guide bot.
# Copy this to .env only if .env does not already exist; never commit real values.

# Required for the current Telegram runtime. Keep secrets local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# Empty means owner-only access; the owner is included automatically.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_OWNER_CHAT_ID=

# Required for current Toss market-data checks and runtime market collection.
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
TOSSINVEST_ACCOUNT_SEQ=

# Local PC database path. The runtime creates this directory when it starts.
AGENT_DATA_DIR=E:/work/data

# Guide-only runtime. Keep both legacy live-order switches disabled.
AGENT_EXECUTION_ENV=mock
AGENT_LIVE_TRADING_ENABLED=false
TOSSINVEST_LIVE_ORDERS=false

# KRX scheduled guide window. Keep the PC awake while the bot is running.
DAILY_GUIDE_HOUR_KST=9
DAILY_GUIDE_MINUTE_KST=10

# Optional research discovery is off for the initial setup.
CROSSREF_DISCOVERY_ENABLED=false

# Optional local calendar correction file; leave empty unless verified by an operator.
KRX_CALENDAR_OVERRIDES=

# Optional reference values and providers. Leave blank unless you choose to configure them.
AGENT_ACCOUNT_EQUITY_KRW=
OPENDART_API_KEY=
ECOS_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
MIRAE_PAPER_COMMISSION_RATE=
